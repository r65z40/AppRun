{
  "expo": {
    "name": "TITRE",
    "slug": "titre",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0B1F",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7B5CFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.titre.prototype",
      "infoPlist": {
        "NSMotionUsageDescription": "TITRE utilise l'inclinaison du téléphone pour donner de la profondeur aux photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7B5CFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#7B5CFF"
        }
      ]
    ],
    "web": {
      "name": "TITRE",
      "shortName": "TITRE",
      "description": "L'actu ultra résumée, 80 % plus vite.",
      "lang": "fr",
      "themeColor": "#0E0B1F",
      "backgroundColor": "#0E0B1F",
      "favicon": "./assets/icon.png",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
